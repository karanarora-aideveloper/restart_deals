# App server config
PORT=3000
# Public URL this backend is reachable at (used to build links to downloaded
# Telegram fallback photos — must be a real internet-reachable HTTPS URL in
# production, not localhost). Defaults to http://localhost:$PORT if unset.
PUBLIC_BASE_URL=https://your-backend-domain.example.com

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/dbname

# Telegram Credentials (get from my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id

TELEGRAM_API_HASH=your_telegram_api_hash

TELEGRAM_SESSION=your_telegram_session_string_filled_automatically_later
TELEGRAM_FITNESS_CHANNEL=fitnessdealsindia
TELEGRAM_GENERAL_CHANNEL=amazondeallovers

# DeepSeek AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key

# WhatsApp Credentials (optional, for Sprint 2)
# WHATSAPP_API_KEY=
