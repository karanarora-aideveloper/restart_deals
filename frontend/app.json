{
  "expo": {
    "name": "ShoppersDeals",
    "slug": "shoppers-deals",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "shoppersdeals",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63ec4ad3-3705-4dda-b9e3-af9066cd57c7",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.dreamwave.shoppersdeals",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dreamwave.shoppersdeals",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#fdfdfd",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "./plugins/withExpoModulesJSIEmbedFix.js",
      "./plugins/withRNFirebaseDisableSPM.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6B00"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-image",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./public/favicon.ico"
    },
    "extra": {
      "eas": {
        "projectId": "63ec4ad3-3705-4dda-b9e3-af9066cd57c7"
      }
    }
  }
}
